cribe to on this dev-only page.\n  22 |     // eslint-disable-next-line react-hooks/set-state-in-effect\n> 23 |     setArmed(true);\n     |     ^^^^^^^^ Avoid calling setState() directly within an effect\n  24 |   }, []);\n  25 |\n  26 |   if (armed) {",["2333"],"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Git_Repo\\InnoVision\\src\\app\\play\\[sessionId]\\page.tsx:358:16\n  356 |     // server-computed seed). Suppressed purity rule for the same reason.\n  357 |     // eslint-disable-next-line react-hooks/purity\n> 358 |     serverNow: Date.now(),\n      |                ^^^^^^^^^^ Cannot call impure function\n  359 |   });\n  360 |\n  361 |   return (",["2334"],"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Git_Repo\\InnoVision\\src\\components\\face\\use-face-pipeline.ts:364:35\n  362 |     // Async POST path — never called during render.\n  363 |     // eslint-disable-next-line react-hooks/purity\n> 364 |     lastVerifyPostAtRef.current = Date.now();\n      |                                   ^^^^^^^^^^ Cannot call impure function\n  365 |     try {\n  366 |       res = await fetch(`/api/face/verify`, {\n  367 |         method: \"POST\",",["2335"],"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-m