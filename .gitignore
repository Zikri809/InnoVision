# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# supabase
/supabase/.branches
/supabase/.temp

# misc
.DS_Store
*.pem
invoice_*.html
invoice_*.pdf

# logs (never commit — have leaked credentials before)
*.log
*.err

# local OCR/tesseract assets (self-hosting is a P9 task; loaded from CDN)
*.traineddata

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.test

# SOPS secrets — the ENCRYPTED file is committed, the PLAINTEXT never is.
# The `.env*` rule above does NOT cover these: it matches names beginning with
# `.env`, while these are `deploy/secrets/prod.env` and `prod.env.enc`. Without
# the explicit rule below the decrypted plaintext (service-role key, Z.ai key,
# sidecar token) would be committable, and `git add deploy/` would do it by
# accident.
deploy/secrets/prod.env
deploy/secrets/prod.env.local
deploy/secrets/*.agekey
deploy/secrets/*.key
# The encrypted payloads ARE tracked (`*.enc` is not ignored) — that is the
# whole point of the SOPS setup, and the template is tracked too.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
/.idea/

# UI exploration screenshots (regenerate with scripts/explore-*.mjs)
/screenshots/

# ZCode session artifacts
/.zcode/

# graphify (local code-graph cache/artifacts; regenerate with `graphify update .`)
/graphify-out/

# CompreFace (defensive — named volumes are used, but protect against a future bind-mount switch)
/compreface-data/

# GLM-OCR benchmark raw timings (regenerate with `npm run glm:bench`)
/bench-glm-ocr.jsonl

# GLM spend governor's durable ledger (WS-CORE src/lib/ai/glm-spend.ts): per-user
# daily OCR token/spend accounting. Written at RUNTIME by the app, resolved
# against the process cwd (default `.glm-spend-ledger.json`; override with
# GLM_SPEND_LEDGER_PATH). Deliberately NOT root-anchored so a ledger written
# into a subdirectory (a custom path, or a container bind-mount that lands
# under a work dir) is still ignored — there is no legitimate tracked file with
# this name.
#
# The GLOB is load-bearing, not cosmetic: the ledger is written tmp-then-rename
# (`${path}.tmp`, glm-spend.ts:258), so a crash or kill between writeFileSync and
# renameSync leaves `.glm-spend-ledger.json.tmp` on disk — the exact-name rule
# alone did NOT match it (`git check-ignore` exit 1), and a `git add -A` would
# then commit the day's per-user accounting.
.glm-spend-ledger.json*

# scratch: dev logs, probe scripts, throwaway screenshots
/.tmp/
/.tmp_*
# audit/coverage scratch produced by critic + coverage runs (not repo artifacts;
# the `/.tmp_*` rule above is root-anchored and does NOT match these names)
/tmp_audit/
/tmp_cov/

# transient agent-work scratch (transcripts, probes, repro dirs) — skills stay tracked
/.agents/*
!/.agents/skills/
# ...but the skills tree re-includes EVERYTHING under it (the negation above
# overrides the `/.agents/*` rule), so compiled Python bytecode from the
# ui-ux-pro-max skill's scripts stayed trackable. audit-3 R3-HYG-F1: exclude
# __pycache__ AFTER the negation so it applies inside skills too.
__pycache__/
*.py[cod]
.eslintcache

# audit-3 R3-DEP-F6: prod-destructive confirmation audit trail. Glob so the
# rotated/partial siblings (`*.1`, `.tmp`) are covered too.
/.prod-audit.log*
