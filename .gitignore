# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# supabase
/supabase/.branches
/supabase/.temp

# misc
.DS_Store
*.pem
invoice_*.html
invoice_*.pdf

# logs (never commit — have leaked credentials before)
*.log
*.err

# local OCR/tesseract assets (self-hosting is a P9 task; loaded from CDN)
*.traineddata

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
/.idea/

# UI exploration screenshots (regenerate with scripts/explore-*.mjs)
/screenshots/

# ZCode session artifacts
/.zcode/

# graphify (local code-graph cache/artifacts; regenerate with `graphify update .`)
/graphify-out/

# CompreFace (defensive — named volumes are used, but protect against a future bind-mount switch)
/compreface-data/

# GLM-OCR benchmark raw timings (regenerate with `npm run glm:bench`)
/bench-glm-ocr.jsonl
