# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (OpenAI-compatible) ───
AI_BASE_URL=https://kenari.id/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# ─── OCR ───
OCR_DEFAULT_ENGINE=tesseract
# LOCAL leg (the vLLM/Docker container): ROOT url, no /v1 — the client appends
# `/v1/models` (probe) and `/v1/chat/completions` (transcription).
GLM_BASE_URL=http://localhost:11434
# Shared by BOTH legs: the local served-model name and the remote Z.ai model id
# are the same string (`glm-ocr`) on different endpoints.
OCR_GLM_MODEL=glm-ocr
# ⚠️ DEAD-BUT-PRESENT: `OCR_VISION_MODEL` has NO reader anywhere in src/** — it
# predates the GLM-OCR proxy (the browser-side "cloud vision" path is gone).
# Kept only so the name is not silently re-invented; do not build a new knob on
# it, and do not confuse it with the remote model id above.
OCR_VISION_MODEL=deepseek-v4-flash
# audit-3 R3-DEP-F2/F3: the GLM-OCR container's own vars live in the
# project-root `.env` (compose reads that, NOT this file — see
# docker-compose.yml and docs/GLM_OCR_SETUP.md §7):
#   VLLM_API_KEY=<secret>        # empty = vLLM auth disabled (local dev)
#   GLM_OCR_REVISION=<hf commit> # weights pin; defaults to the pinned commit
# When VLLM_API_KEY is set, the server proxy (/api/extract/ocr →
# src/lib/ai/http-compat.ts) sends `Authorization: Bearer` using the SAME var
# read by THIS process, so both sides must hold the same value:
#   VLLM_API_KEY=<secret>   # add it here too, not only in the root .env
# Empty on both sides = vLLM auth disabled (local dev default).

# ─── OCR provider selector (which leg the proxy talks to) ───
# TWO LEGS, ONE ROUTE (`POST/GET /api/extract/ocr`):
#   local  (DEFAULT) — the loopback vLLM/Docker container. Free, ONE rasterized
#                      page per call, `GET /v1/models` probe, 200-page cap.
#   remote           — the Z.ai PaaS API. WHOLE document per call,
#                      `POST {ZAI_BASE_URL}/layout_parsing`, BILLED per token.
#
# FAIL-CLOSED: only the exact value `remote` (case-insensitive, trimmed)
# selects the metered leg. Unset, `local`, or ANY unrecognised value (`prod`,
# `remote-api`, a typo) selects `local`, with a one-time warn in the server log
# naming the fact but never the value. An operator typo can therefore never
# silently start spending money on the shared Z.ai key.
# SERVER-ONLY — never `NEXT_PUBLIC_*`: a public selector would ship to the
# browser and let the client choose the leg that costs money.
GLM_PROVIDER=local

# ─── OCR remote leg (Z.ai) — read only when GLM_PROVIDER=remote ───
# ⚠️ GLM_PROVIDER=remote SPENDS MONEY: every document parse bills ZAI_API_KEY at
# GLM_TOKEN_PRICE_PER_MILLION. The spend governor below is the only ceiling, and
# the ledger is per-host (single-instance is a documented constraint). Read
# docs/GLM_OCR_SETUP.md §"Remote API mode (Z.ai)" and docs/DEPLOY_VPS.md first.
#
# The Z.ai PaaS root. The ROOT ALREADY CARRIES `/api/paas/v4` — the client
# appends only `/layout_parsing`, so do NOT append `/v1` (…/paas/v4/v1/… 404s)
# and do NOT point this at the local container (that is GLM_BASE_URL's job).
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# The Z.ai API key (Z.AI Open Platform → API Keys; register → top-up → create).
# REQUIRED when GLM_PROVIDER=remote — the remote leg never falls back to local
# and never presents VLLM_API_KEY to Z.ai, so a missing key is a hard 503
# `glm_model_unavailable`, not a silent downgrade.
# SERVER-ONLY: never `NEXT_PUBLIC_*`. A public key var is inlined into the
# browser bundle, i.e. handed to every student. Never log or echo it either —
# src/lib/ai/http-compat.ts masks any upstream echo of the configured key.
# ZAI_API_KEY=

# ─── OCR remote spend governor (gate G8) ───
# Every value here is read at CALL time (no module-load caching, so a change to
# the process env takes effect on the next request) — but `process.env` itself is
# fixed when the process starts, so editing THIS file still needs a restart.
# Interim page cap for the remote leg. The Z.ai docs CONFLICT — the guide says
# 100 pages, the API reference says 30 — so this repo ships the LOWER bound
# until a live curl resolves it (see the OWED list in docs/GLM_OCR_SETUP.md).
# A PDF over the cap is refused client-side BEFORE upload/spend
# (`glm_pages_exceeded`, 413) and re-checked server-side against a cheap
# `/Type /Page` lower bound. Unparseable/non-positive values fall back to 30.
GLM_REMOTE_MAX_PAGES=30
# Per-user DAILY token ceiling, UTC day bucket. On reaching it every further
# remote call is 429 `glm_spend_cap` until the next UTC day. 2,000,000 tokens
# ≈ $0.06/user/day at the price below — tune it against measured tokens/page
# (still OWED; a 4096px canvas may tokenize well over a naive estimate).
GLM_DAILY_TOKEN_CAP=2000000
# USD per 1M tokens, charged on input AND output alike (Z.ai list: $0.03/1M).
# Used only to compute `costUsd` in the redacted `[glm-usage]` log line and in
# the ledger — it is never sent upstream. 0 is a legal value (cost logging off).
GLM_TOKEN_PRICE_PER_MILLION=0.03
# Durable ledger path, resolved against the process cwd (the container's /app;
# the Dockerfile chowns /app to `node` so this file is writable). Gitignored.
# Shape: { "<utc-day>": { "<userId>": { tokens, usd, calls } } }, last 7 days.
# ⚠️ PER-HOST: two app replicas sharing one Z.ai key still double-spend, since
# each process enforces the cap against the file it can see — that residual is
# exactly why the VPS target is SINGLE-INSTANCE (docs/DEPLOY_VPS.md). A write
# failure only warns; the in-memory count stays authoritative for that process,
# so an un-persisted day is lost on restart.
GLM_SPEND_LEDGER_PATH=.glm-spend-ledger.json
# Operator kill switch: `1` refuses EVERY remote OCR call with 503
# `glm_model_unavailable`, regardless of usage, while the rest of the stack
# keeps running. Any other value (including `0`) leaves the leg enabled. Reach
# for it when the key must stop spending NOW (leaked key, runaway deck) —
# unlike GLM_PROVIDER=local it needs no redeploy, only a restart.
GLM_SPEND_DISABLED=0

# ─── OCR liveness probe cache (gate G7) ───
# The REMOTE probe is a REAL, BILLED `layout_parsing` POST of a 1×1 PNG: it is
# the only check that proves the key works AND the account has balance AND OCR
# is entitled (a 401/403 is the only way to learn a key is dead). Because it
# costs money the verdict is cached in-process, so N lecturers × N dialog opens
# do not each bill a probe:
#   positive (available)   TTL — default 300000 ms (5 min)
#   negative (unavailable) TTL — default 30000 ms (30 s), so a repaired key
#     comes back without a restart while a dead one is not re-billed often.
# The LOCAL leg's probe is a free `GET /v1/models`, so these TTLs only change
# how often it is re-checked (the verdict is cached for both legs — on local
# that is a latency saving, on remote it is a cost control).
# Raise the positive TTL to probe less; lower the negative TTL to recover
# faster. Unparseable/non-positive values fall back to the defaults — never 0,
# which would disable the cache and bill one probe per picker open on remote.
GLM_PROBE_TTL_MS=300000
GLM_PROBE_NEGATIVE_TTL_MS=30000

# ─── Face ───

# ─── InsightFace sidecar (self-hosted face recognition, Docker) ───
INSIGHTFACE_BASE_URL=http://localhost:8000
FACE_SIDECAR_TOKEN=            # shared secret for /extract + /health (empty = disabled; set in production)
FACE_MOCK_ENABLED=0            # set to 1 for E2E / unit tests (never in production)

# ─── Grounded web search (TinyFish Search + Fetch — free tier) ───
# Absent key hides the "Web topic" source mode in the generate dialog.
TINYFISH_API_KEY=
# Optional overrides (the e2e harness points these at its mock server):
# TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# ─── Lecturer provisioning (server-side invite code; empty = lecturer self-signup disabled) ───
LECTURER_INVITE_CODE=
# audit-2 M-19 rotation grace: keep the PREVIOUS code valid while in-flight
# email confirmations drain (set PREVIOUS=old, CODE=new; drop PREVIOUS after
# the grace window).
# LECTURER_INVITE_CODE_PREVIOUS=

# ─── Microsoft institutional SSO (AU-2) ───
# Comma-separated allowlist of university email domains. Empty = SSO disabled
# (no "Sign in with Microsoft" button; callback rejects everything).
# Requires the Supabase Azure provider configured tenant-specific in the
# dashboard (personal accounts never reach the consent screen; this list is
# the second trust layer).
INSTITUTIONAL_EMAIL_DOMAINS=

# ─── Rate limits (per-window budgets — defaults are production posture) ───
# The e2e harness raises these (playwright.config.ts webServer env) because
# the suite bursts past per-minute windows from one IP.
SIGNUP_RATE_LIMIT=10
INVITE_RATE_LIMIT=10
RESET_RATE_LIMIT=5
# audit-3 R2-TOP-F5: per-IP budgets are classroom-NAT tolerant (30/min), per
# the login-IP precedent — a lecture hall shares one egress IP.
RESET_IP_RATE_LIMIT=30
RESET_CONFIRM_RATE_LIMIT=10
MATRIC_CAPTURE_RATE_LIMIT=30
# audit-3 R2-TOP-F3: per-email DAILY ceiling on recovery emails (long-window
# bucket, separate from RESET_RATE_LIMIT) so a sustained probe cannot exhaust
# the SMTP quota. 24h window; in-memory (single Node process).
RESET_EMAIL_DAILY_LIMIT=10

# ─── AI streaming ───
# Inter-chunk idle abort for streamed AI responses (ms). A silent upstream
# releases the route after this instead of holding it for the platform 504.
AI_STREAM_IDLE_TIMEOUT_MS=90000

# ─── Server-side link origin (audit-2 H-02) ───
# Absolute origin used for every redirectTo/emailRedirectTo the server hands
# to GoTrue (password reset, email confirmation bounce, SSO callback). NEVER
# derived from request headers in production — a forged Host header used to
# be able to point recovery links at an attacker origin. Empty in production
# degrades to RELATIVE redirect paths (GoTrue resolves against its own Site
# URL); in dev the request headers are used when this is unset.
# SITE_URL=https://innovision.example.edu

# ─── CSRF / reverse-proxy trust (audit-3 R2-TOP-F1) ───
# Comma-separated, scheme-included origins allowed to differ from Host.
# Required whenever the browser origin differs from the SERVER's bind host —
# this includes the documented direct-LAN posture (browser at
# http://<lan-ip>:3000 while the server binds localhost): Next builds
# `request.url` from the bind hostname, not the browser's Host, so
# checkSameOrigin (src/lib/http.ts) 403s every browser API mutation without
# this entry. Also covers cloudflared-style tunnels.
# The same list feeds Next's server-action / dev-origin allowlist via
# next.config.ts (ALLOWED_ORIGINS / TRUSTED_ORIGINS / NEXT_PUBLIC_SITE_URL /
# SITE_URL), so actions and route handlers agree.
# Empty = only same-origin-as-server-bind requests pass (see checkSameOrigin).
# Example: TRUSTED_ORIGINS=https://innovision.example.edu,http://192.168.1.50:3000
TRUSTED_ORIGINS=

# Number of TRUSTED reverse proxies in front of the app, for client-IP
# resolution (src/lib/request-ip.ts). The client IP is taken that many entries
# from the RIGHT of X-Forwarded-For, so a client cannot rotate its own budget
# by prepending junk.
#   UNSET or 1 (the default) = one trusted hop, i.e. the documented Cloudflare
#     tunnel / nginx posture: the rightmost entry is proxy-appended and IS used.
#   N > 1                    = a longer chain; take the entry N from the right.
#   0                        = trust NO forwarding header. Use this for a
#     DIRECT-access (no proxy) deployment: every per-IP budget then shares one
#     bucket, which defeats header rotation but also means the per-IP limits
#     act as a GLOBAL cap. Without it, a direct-access client that sends
#     `X-Forwarded-For: <random>` mints a fresh bucket per request and bypasses
#     every per-IP budget (audit-3 H-F5).
# TRUSTED_PROXY_COUNT=0

# ─── Public deployment origin (audit-3 H-F8 / R2-TOP-F1) ───
# The deployment's public origin. Feeds next.config.ts's allowedDevOrigins +
# serverActions.allowedOrigins (with TRUSTED_ORIGINS and ALLOWED_ORIGINS), so
# a staging / second-institution deploy needs no code edit. The current
# Cloudflare tunnel host is the built-in default; set this (or the vars above)
# for any other deployment. Example: NEXT_PUBLIC_SITE_URL=https://innovision.example.edu
# NEXT_PUBLIC_SITE_URL=

# Extra hostnames for the Next dev-origin / server-action allowlists (wildcards
# allowed). Comma-separated. Example: ALLOWED_ORIGINS=*.example.edu,staging.example.edu
# ALLOWED_ORIGINS=

# ─── Face anti-spoofing (audit-2 C-01) ───
# 1 = a majority-spoofed verify (MiniFASNet print/replay ensemble in the
# sidecar) forces a FAIL vote; 0/unset = verdicts recorded for lecturer
# audit but never enforced (right for sidecars built before the weights
# were baked — rebuild with `docker compose build insightface-service`).
# Set to 1 in production.
# FACE_SPOOF_ENFORCE=1

# ─── Kill switches / harness-only flags (NEVER set to 1 in production) ───
# Disables every hardcoded per-route rate budget (e2e harness only).
E2E_RATE_LIMIT_DISABLED=0
# PROD_ENV_STRICT arms the fail-closed production env gate
# (src/lib/prod-guards.ts, run once per server start from src/instrumentation.ts
# `register()` — gates S1/S5). With `NODE_ENV=production` AND `PROD_ENV_STRICT=1`
# the gate EXITS THE PROCESS (exit 1, not merely a throw — Next keeps the
# listener bound after a rejected `register()`, which would answer 500 to every
# request) when any of these is true:
#   - a harness kill switch below is `1` (they are inlined into the client
#     bundle, so a harness-built image promoted to a VPS keeps them forever);
#   - `FACE_SIDECAR_TOKEN` is empty while face is REAL (i.e. not both mock flags)
#     — the sidecar's /extract would be an unauthenticated embedding oracle;
#   - `GLM_PROVIDER=remote` with an empty `ZAI_API_KEY`, or the LOCAL leg active
#     with an empty `VLLM_API_KEY` — an unauthenticated OCR endpoint;
#   - `TRUSTED_PROXY_COUNT` is set but not a non-negative integer.
# WITHOUT the flag the same findings are a single warn line naming the KEYS
# (never the values) — i.e. the VPS boots happily with a dead control. The
# Playwright harness deliberately runs a production build with the kill switches
# ON and does not set this, which is why the hard fail is gated on the flag
# rather than on `NODE_ENV` alone. The VPS app service MUST set `PROD_ENV_STRICT=1`
# (see docs/DEPLOY_VPS.md §Tokens + kill switches).
# PROD_ENV_STRICT=1

# ─── Login rate budgets (audit-2 H-01, revised by audit-3 A-F4) ───
# The per-IP budget is the REQUEST GATE, and is loose for classroom NAT (one
# egress IP for a lecture hall).
# LOGIN_IP_RATE_LIMIT=30
# The per-account budget is a FAILURE DETECTION counter, not a gate: a
# successful sign-in clears it and crossing it only logs a warning. It was
# demoted from a gate because gating on failures hands every known address an
# indefinite lockout switch (5 bogus attempts/min kept a victim out of their
# own account). See src/lib/auth/login.ts.
# LOGIN_EMAIL_FAIL_THRESHOLD=5
# Enables the fake face-tracker seam in PRODUCTION builds (e2e harness only —
# src/lib/face/seam-gate.ts; a production deployment with this ON would let
# marker frames bypass face verification).
NEXT_PUBLIC_E2E_FAKE_SEAM=0
# Bakes the clipboard/fullscreen hardening OFF at build time (integrity-e2e
# job sets this for the MAIN suite; e51 runs a build WITHOUT it).
NEXT_PUBLIC_INTEGRITY_HARDENING_OFF=0
