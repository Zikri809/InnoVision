# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (OpenAI-compatible) ───
AI_BASE_URL=https://kenari.id/v1
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# ─── OCR ───
OCR_DEFAULT_ENGINE=tesseract
GLM_BASE_URL=http://localhost:11434
OCR_GLM_MODEL=glm-ocr
OCR_VISION_MODEL=deepseek-v4-flash

# ─── Face ───

# ─── InsightFace sidecar (self-hosted face recognition, Docker) ───
INSIGHTFACE_BASE_URL=http://localhost:8000
FACE_SIDECAR_TOKEN=            # shared secret for /extract + /health (empty = disabled; set in production)
FACE_MOCK_ENABLED=0            # set to 1 for E2E / unit tests (never in production)

# ─── Grounded web search (TinyFish Search + Fetch — free tier) ───
# Absent key hides the "Web topic" source mode in the generate dialog.
TINYFISH_API_KEY=
# Optional overrides (the e2e harness points these at its mock server):
# TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
# TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# ─── Lecturer provisioning (server-side invite code; empty = lecturer self-signup disabled) ───
LECTURER_INVITE_CODE=

# ─── Microsoft institutional SSO (AU-2) ───
# Comma-separated allowlist of university email domains. Empty = SSO disabled
# (no "Sign in with Microsoft" button; callback rejects everything).
# Requires the Supabase Azure provider configured tenant-specific in the
# dashboard (personal accounts never reach the consent screen; this list is
# the second trust layer).
INSTITUTIONAL_EMAIL_DOMAINS=

# ─── Rate limits (per-window budgets — defaults are production posture) ───
# The e2e harness raises these (playwright.config.ts webServer env) because
# the suite bursts past per-minute windows from one IP.
SIGNUP_RATE_LIMIT=10
INVITE_RATE_LIMIT=10
RESET_RATE_LIMIT=5
RESET_IP_RATE_LIMIT=10
RESET_CONFIRM_RATE_LIMIT=10
MATRIC_CAPTURE_RATE_LIMIT=5

# ─── AI streaming ───
# Inter-chunk idle abort for streamed AI responses (ms). A silent upstream
# releases the route after this instead of holding it for the platform 504.
AI_STREAM_IDLE_TIMEOUT_MS=90000

# ─── CSRF / reverse-proxy trust ───
# Comma-separated, scheme-included origins allowed to differ from Host /
# x-forwarded-host (cloudflared-style proxies that strip forwarding headers).
# Empty = direct-access + x-forwarded-host matching only.
TRUSTED_ORIGINS=

# ─── Kill switches / harness-only flags (NEVER set to 1 in production) ───
# Disables every hardcoded per-route rate budget (e2e harness only).
E2E_RATE_LIMIT_DISABLED=0
# Enables the fake face-tracker seam in PRODUCTION builds (e2e harness only —
# src/lib/face/seam-gate.ts; a production deployment with this ON would let
# marker frames bypass face verification).
NEXT_PUBLIC_E2E_FAKE_SEAM=0
# Bakes the clipboard/fullscreen hardening OFF at build time (integrity-e2e
# job sets this for the MAIN suite; e51 runs a build WITHOUT it).
NEXT_PUBLIC_INTEGRITY_HARDENING_OFF=0
