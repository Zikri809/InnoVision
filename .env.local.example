# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (OpenAI-compatible) ───
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── OCR ───
OCR_DEFAULT_ENGINE=tesseract
OLLAMA_BASE_URL=http://localhost:11434
OCR_GLM_MODEL=glm-ocr
OCR_VISION_MODEL=gpt-4o-mini

# ─── Face / Timer ───
TIMER_GRACE_SEC=5

# ─── CompreFace (self-hosted face recognition, Docker) ───
COMPREFACE_BASE_URL=http://localhost:8000
COMPREFACE_API_KEY=            # set after first run (see docs/COMPREFACE_SETUP.md)
COMPREFACE_MOCK_ENABLED=0      # set to 1 for E2E / unit tests (never in production)

# ─── Lecturer provisioning (server-side invite code; empty = lecturer self-signup disabled) ───
LECTURER_INVITE_CODE=
